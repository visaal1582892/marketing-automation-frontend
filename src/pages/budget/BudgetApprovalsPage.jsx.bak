import React, { useEffect, useState } from 'react'
import { useNavigate } from 'react-router-dom'
import { budgetTopupApi } from '../../api/budgetTopup'
import { budgetPlanningApi } from '../../api/budgetPlanning'
import { useToast } from '../../components/Toast'
import Icon from '../../components/Icon'
import Modal from '../../components/Modal'
import ActionMenu, { ActionMenuItem } from '../../components/ActionMenu'
import { formatTaskId } from '../../utils/formatters'

const formatCurrency = (val) =>
  new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 2 }).format(Number(val) || 0)

const formatDate = (dtStr) => {
  if (!dtStr) return 'N/A'
  return new Date(dtStr).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })
}

// ─── Small info chip ─────────────────────────────────────────────────────────
const Chip = ({ label, value, variant = 'default' }) => {
  const variants = {
    default: 'bg-slate-100 text-slate-700',
    brand: 'bg-brand-50 text-brand-700',
    accent: 'bg-accent-50 text-accent-700',
    amber: 'bg-amber-50 text-amber-700',
  }
  return (
    <div className={`rounded-lg px-3 py-2 flex flex-col gap-0.5 min-w-0 ${variants[variant]}`}>
      <span className="text-[10px] font-semibold uppercase tracking-wider opacity-60 leading-none">{label}</span>
      <span className="text-sm font-bold truncate">{value}</span>
    </div>
  )
}

// ─── Empty state ─────────────────────────────────────────────────────────────
function EmptyState({ icon, title, sub }) {
  return (
    <div className="bg-white border border-slate-200 rounded-xl p-12 sm:p-16 text-center">
      <div className="inline-flex p-4 rounded-full mb-4 bg-slate-100 text-slate-400">
        <Icon name={icon} className="h-10 w-10" />
      </div>
      <h3 className="text-lg font-semibold text-slate-700">{title}</h3>
      <p className="text-slate-400 mt-1.5 text-sm">{sub}</p>
    </div>
  )
}

// ─── Top-Up Group Card ────────────────────────────────────────────────────────
function TopupGroupCard({ group, onAction }) {
  const [expanded, setExpanded] = useState(false)
  const topupCount = group.topups?.length || 0

  return (
    <div className="bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md hover:border-brand-200 transition-all duration-200 overflow-hidden">
      {/* Card header */}
      <div className="bg-brand-50 border-b border-brand-100 px-4 sm:px-6 py-3 flex items-center justify-between gap-3">
        <div className="flex flex-wrap items-center gap-2.5 min-w-0">
          <span className="text-sm font-bold text-slate-800 font-mono shrink-0">{formatTaskId(group.taskId)}</span>
          <span className="hidden sm:block h-4 w-px bg-brand-200" />
          <span className="text-sm text-slate-500 font-medium truncate max-w-[180px] sm:max-w-none">
            {group.verticalName || group.taskTypeName || '—'}
          </span>
        </div>
        <div className="shrink-0 ml-auto">
          <ActionMenu align="right">
            <ActionMenuItem icon="checkCircle" label="Approve Top-Up" variant="success" onClick={() => onAction(group, 'approve')} />
            <ActionMenuItem icon="xCircle" label="Reject Top-Up" variant="danger" onClick={() => onAction(group, 'reject')} />
          </ActionMenu>
        </div>
      </div>

      {/* Card body */}
      <div className="px-4 sm:px-6 py-5">
        {/* Key metrics */}
        <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-5">
          <Chip label="Total Top-Up" value={formatCurrency(group.totalTopupAmount)} variant="brand" />
          <Chip label="Requestor" value={group.requestorName || '—'} />
          <Chip label="Assignee" value={group.assigneeName || '—'} />
          <Chip label="Raised" value={formatDate(group.createdAt)} />
        </div>

        {/* Task meta */}
        {(group.taskTypeName) && (
          <div className="flex flex-wrap gap-x-6 gap-y-1 text-xs text-slate-500 mb-4">
            <span><span className="font-semibold text-slate-600">Task Type:</span> {group.taskTypeName}</span>
          </div>
        )}

        {/* Expandable individual rows */}
        {topupCount > 0 && (
          <div>
            <button
              onClick={() => setExpanded(v => !v)}
              className="flex items-center gap-1.5 text-xs font-semibold text-brand-600 hover:text-brand-800 transition-colors mb-2"
            >
              <Icon name={expanded ? 'chevron-up' : 'chevron-down'} className="h-3.5 w-3.5" />
              {expanded ? 'Hide' : 'Show'} individual requests ({topupCount})
            </button>
            {expanded && (
              <div className="rounded-xl border border-slate-200 overflow-hidden">
                <div className="overflow-x-auto">
                  <table className="min-w-full text-xs">
                    <thead className="bg-slate-50 border-b border-slate-200">
                      <tr>
                        <th className="px-3 py-2 text-left font-semibold text-slate-500 uppercase tracking-wider">State</th>
                        <th className="px-3 py-2 text-left font-semibold text-slate-500 uppercase tracking-wider">Vertical</th>
                        <th className="px-3 py-2 text-left font-semibold text-slate-500 uppercase tracking-wider">Period</th>
                        <th className="px-3 py-2 text-right font-semibold text-slate-500 uppercase tracking-wider">Amount</th>
                        <th className="px-3 py-2 text-left font-semibold text-slate-500 uppercase tracking-wider hidden sm:table-cell">Requested By</th>
                        <th className="px-3 py-2 text-left font-semibold text-slate-500 uppercase tracking-wider hidden sm:table-cell">Remarks</th>
                      </tr>
                    </thead>
                    <tbody className="bg-white divide-y divide-slate-100">
                      {group.topups.map((t, i) => (
                        <tr key={t.id || i} className="hover:bg-brand-50/40 transition-colors">
                          <td className="px-3 py-2.5 font-semibold text-slate-800">{t.stateCode || '—'}</td>
                          <td className="px-3 py-2.5 text-slate-600">{t.verticalName || '—'}</td>
                          <td className="px-3 py-2.5 text-slate-500">{t.periodName || '—'}</td>
                          <td className="px-3 py-2.5 text-right font-bold text-brand-700">{formatCurrency(t.topupAmount ?? t.amount)}</td>
                          <td className="px-3 py-2.5 text-slate-500 hidden sm:table-cell">{t.requestedByName || '—'}</td>
                          <td className="px-3 py-2.5 text-slate-400 truncate max-w-[120px] hidden sm:table-cell">{t.remarks || '—'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  )
}

// ─── Main Page ────────────────────────────────────────────────────────────────
export default function BudgetApprovalsPage() {
  const navigate = useNavigate()
  const toast = useToast()
  const showToast = (msg, type = 'info') => toast[type]?.(msg)

  const [activeTab, setActiveTab] = useState('proposals')
  const [loading, setLoading] = useState(false)
  const [proposals, setProposals] = useState([])
  const [topupGroups, setTopupGroups] = useState([])

  // Proposal modal
  const [selectedProposal, setSelectedProposal] = useState(null)
  const [proposalAction, setProposalAction] = useState(null)
  const [proposalComments, setProposalComments] = useState('')
  const [proposalCommentsError, setProposalCommentsError] = useState(false)
  const [submitting, setSubmitting] = useState(false)

  // Bulk top-up modal
  const [bulkModal, setBulkModal] = useState(null)
  const [selectedIds, setSelectedIds] = useState(new Set())
  const [bulkComments, setBulkComments] = useState('')
  const [bulkCommentsError, setBulkCommentsError] = useState(false)
  const [bulkSubmitting, setBulkSubmitting] = useState(false)

  const loadData = async () => {
    setLoading(true)
    try {
      const [proposalsRes, groupedRes] = await Promise.all([
        budgetPlanningApi.getProposals().catch(() => []),
        budgetTopupApi.getPendingTopUpsGrouped().catch(() => []),
      ])
      setProposals((proposalsRes || []).filter(p => p.status === 'PENDING_APPROVAL'))
      setTopupGroups(groupedRes || [])
    } catch {
      showToast('Failed to load approvals', 'error')
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => { loadData() }, [])

  // ── Proposal modal handlers ─────────────────────────────────────────────────
  const openProposalModal = (proposal, action) => {
    setSelectedProposal(proposal)
    setProposalAction(action)
    setProposalComments('')
    setProposalCommentsError(false)
  }
  const closeProposalModal = () => {
    setSelectedProposal(null); setProposalAction(null)
    setProposalComments(''); setProposalCommentsError(false)
  }
  const handleProposalConfirm = async () => {
    if (!selectedProposal || !proposalAction) return
    if (proposalAction === 'reject' && !proposalComments.trim()) { setProposalCommentsError(true); return }
    setSubmitting(true)
    try {
      if (proposalAction === 'approve') {
        await budgetPlanningApi.approveProposal(selectedProposal.id, false)
        showToast('Budget proposal approved', 'success')
      } else {
        await budgetPlanningApi.rejectProposal(selectedProposal.id, { reason: proposalComments })
        showToast('Budget proposal rejected', 'info')
      }
      closeProposalModal(); loadData()
    } catch (err) {
      if (proposalAction === 'approve' && err.response?.status === 409 && err.response?.data?.message === 'ACTIVE_PROPOSAL_EXISTS') {
        try {
          await budgetPlanningApi.approveProposal(selectedProposal.id, true)
          showToast('Budget proposal approved (Old Active Terminated)', 'success')
          closeProposalModal(); loadData()
        } catch (ie) { showToast(ie?.response?.data?.message || 'Failed to approve with override', 'error') }
      } else {
        showToast(err?.response?.data?.message || `Failed to ${proposalAction}`, 'error')
      }
    } finally { setSubmitting(false) }
  }

  // ── Bulk modal handlers ─────────────────────────────────────────────────────
  const openBulkModal = (group, action) => {
    setBulkModal({ group, action })
    setSelectedIds(new Set((group.topups || []).map(t => t.id)))
    setBulkComments(''); setBulkCommentsError(false)
  }
  const closeBulkModal = () => { setBulkModal(null); setSelectedIds(new Set()); setBulkComments(''); setBulkCommentsError(false) }
  const toggleId = (id) => setSelectedIds(prev => { const n = new Set(prev); n.has(id) ? n.delete(id) : n.add(id); return n })
  const selectAll = () => setSelectedIds(new Set((bulkModal?.group?.topups || []).map(t => t.id)))
  const clearAll = () => setSelectedIds(new Set())

  const handleBulkConfirm = async () => {
    if (!bulkModal) return
    if (selectedIds.size === 0) { showToast('Select at least one request', 'warning'); return }
    if (bulkModal.action === 'reject' && !bulkComments.trim()) { setBulkCommentsError(true); return }
    setBulkSubmitting(true)
    try {
      const topupIds = [...selectedIds]
      if (bulkModal.action === 'approve') {
        await budgetTopupApi.bulkApproveTopUps({ topupIds, comments: bulkComments })
        showToast(`${topupIds.length} top-up(s) approved`, 'success')
      } else {
        await budgetTopupApi.bulkRejectTopUps({ topupIds, comments: bulkComments })
        showToast(`${topupIds.length} top-up(s) rejected`, 'info')
      }
      closeBulkModal(); loadData()
    } catch (err) {
      showToast(err?.response?.data?.message || 'Failed to process top-ups', 'error')
    } finally { setBulkSubmitting(false) }
  }

  const topupPendingCount = topupGroups.reduce((s, g) => s + (g.topups?.length || 0), 0)

  return (
    <div className="min-h-screen bg-slate-100 font-sans">
      <div className="max-w-6xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-8 space-y-4 sm:space-y-6">

        {/* ── Page Header ── */}
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4">
          <div className="flex items-center gap-3 min-w-0">
            <span className="p-2.5 rounded-xl bg-brand-100 text-brand-600 shrink-0 shadow-sm">
              <Icon name="briefcase" className="h-6 w-6" />
            </span>
            <div className="min-w-0">
              <h1 className="text-xl sm:text-2xl font-bold text-slate-800 tracking-tight">Budget Approvals</h1>
              <p className="mt-0.5 text-slate-500 text-xs sm:text-sm truncate">Review budget proposals and top-up requests</p>
            </div>
          </div>
          <button
            onClick={loadData}
            disabled={loading}
            className="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-lg shadow-sm text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-300 transition-colors disabled:opacity-50 shrink-0"
          >
            <Icon name="refresh-cw" className={`h-4 w-4 ${loading ? 'animate-spin' : ''}`} />
            <span>Refresh</span>
          </button>
        </div>

        {/* ── Segmented Control Tabs ── */}
        <div className="bg-slate-200/70 p-1 sm:p-1.5 rounded-2xl border border-slate-200/80 shadow-inner">
          <div className="grid grid-cols-2 gap-1">
            {/* Budget Proposals tab */}
            <button
              onClick={() => setActiveTab('proposals')}
              className={`flex items-center justify-center gap-1.5 sm:gap-2 px-3 sm:px-6 py-2.5 sm:py-3 text-xs sm:text-sm font-bold rounded-xl transition-all duration-200 ${activeTab === 'proposals'
                ? 'bg-white text-brand-700 shadow-sm ring-1 ring-slate-200/60'
                : 'text-slate-600 hover:text-slate-900 hover:bg-white/50'
                }`}
            >
              <Icon name="file-text" className={`h-4 w-4 shrink-0 ${activeTab === 'proposals' ? 'text-brand-600' : 'text-slate-400'}`} />
              <span className="truncate">
                <span className="hidden sm:inline">Budget </span>Proposals
              </span>
              {proposals.length > 0 && (
                <span
                  className={`px-1.5 sm:px-2 py-0.5 rounded-full text-[10px] sm:text-xs font-bold leading-none shrink-0 ${activeTab === 'proposals' ? 'bg-brand-100 text-brand-700' : 'bg-slate-300/80 text-slate-700'
                    }`}
                >
                  {proposals.length}
                </span>
              )}
            </button>

            {/* Top Up Approvals tab */}
            <button
              onClick={() => setActiveTab('topups')}
              className={`flex items-center justify-center gap-1.5 sm:gap-2 px-3 sm:px-6 py-2.5 sm:py-3 text-xs sm:text-sm font-bold rounded-xl transition-all duration-200 ${activeTab === 'topups'
                ? 'bg-white text-brand-700 shadow-sm ring-1 ring-slate-200/60'
                : 'text-slate-600 hover:text-slate-900 hover:bg-white/50'
                }`}
            >
              <Icon name="plus-circle" className={`h-4 w-4 shrink-0 ${activeTab === 'topups' ? 'text-brand-600' : 'text-slate-400'}`} />
              <span className="truncate">
                <span className="hidden sm:inline">Top Up </span>Approvals
              </span>
              {topupPendingCount > 0 && (
                <span
                  className={`px-1.5 sm:px-2 py-0.5 rounded-full text-[10px] sm:text-xs font-bold leading-none shrink-0 ${activeTab === 'topups' ? 'bg-brand-100 text-brand-700' : 'bg-slate-300/80 text-slate-700'
                    }`}
                >
                  {topupPendingCount}
                </span>
              )}
            </button>
          </div>
        </div>

        {/* ── Loading ── */}
        {loading && (
          <div className="bg-white border border-slate-200 rounded-xl p-12 sm:p-16 flex flex-col items-center justify-center text-slate-400">
            <Icon name="loader" className="h-8 w-8 animate-spin text-brand-500 mb-3" />
            <div className="text-sm font-medium">Loading…</div>
          </div>
        )}

        {/* ════════════════════════════════════════
            TAB: Budget Proposals
        ════════════════════════════════════════ */}
        {!loading && activeTab === 'proposals' && (
          proposals.length === 0
            ? <EmptyState icon="check-circle" title="No Proposals Pending" sub="All budget proposals have been reviewed." />
            : (
              <div>
                {/* Mobile Cards View (<640px) */}
                <div className="space-y-4 sm:hidden">
                  {proposals.map(p => (
                    <div key={p.id} className="bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md transition-all overflow-hidden">
                      {/* Card Header */}
                      <div className="bg-slate-50 border-b border-slate-200 px-4 py-3 flex items-center justify-between">
                        <div className="flex items-center gap-2">
                          <span className="text-sm font-bold text-slate-800 font-mono">{p.financialYear || '—'}</span>
                        </div>
                        <span className="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">
                          Pending Approval
                        </span>
                      </div>

                      {/* Card Body */}
                      <div className="p-4 space-y-3">
                        <div className="grid grid-cols-2 gap-2">
                          <Chip label="Total Annual Budget" value={formatCurrency(p.totalAnnualBudget)} variant="brand" />
                          <Chip label="Requested By" value={p.createdByName || '—'} />
                          <Chip label="Submitted Date" value={formatDate(p.updatedAt)} />
                          <Chip label="Type" value="Initial Proposal" />
                        </div>

                        {/* Actions */}
                        <div className="flex items-center justify-between pt-3 border-t border-slate-100">
                          <span className="text-xs text-slate-400 font-medium">Actions</span>
                          <ActionMenu align="right">
                            <ActionMenuItem icon="eye" label="View Proposal" onClick={() => navigate(`/budget-planning/wizard/${p.id}/step1?readOnly=true&fromApprovals=true&source=approvals`)} />
                            <ActionMenuItem icon="checkCircle" label="Approve Proposal" variant="success" onClick={() => openProposalModal(p, 'approve')} />
                            <ActionMenuItem icon="xCircle" label="Reject Proposal" variant="danger" onClick={() => openProposalModal(p, 'reject')} />
                          </ActionMenu>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>

                {/* Desktop & Tablet Table View (>=640px) */}
                <div className="hidden sm:block bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                  <div className="overflow-x-auto">
                    <table className="min-w-full divide-y divide-slate-100">
                      <thead className="bg-slate-50 border-b border-slate-200">
                        <tr>
                          <th className="px-5 py-3.5 text-xs font-semibold text-slate-500 uppercase tracking-wider text-left">Financial Year</th>
                          <th className="px-5 py-3.5 text-xs font-semibold text-slate-500 uppercase tracking-wider text-left">Total Annual Budget</th>
                          <th className="px-5 py-3.5 text-xs font-semibold text-slate-500 uppercase tracking-wider text-left">Requested By</th>
                          <th className="px-5 py-3.5 text-xs font-semibold text-slate-500 uppercase tracking-wider text-left">Submitted Date</th>
                          <th className="px-5 py-3.5 text-xs font-semibold text-slate-500 uppercase tracking-wider text-left">Remarks</th>
                          <th className="px-5 py-3.5 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">Actions</th>
                        </tr>
                      </thead>
                      <tbody className="bg-white divide-y divide-slate-100">
                        {proposals.map(p => (
                          <tr key={p.id} className="hover:bg-slate-50/80 transition-colors group">
                            <td className="px-5 py-4 text-sm font-bold text-slate-900 font-mono">{p.financialYear || '—'}</td>
                            <td className="px-5 py-4 text-sm font-bold text-brand-700">{formatCurrency(p.totalAnnualBudget)}</td>
                            <td className="px-5 py-4 text-sm font-medium text-slate-700">{p.createdByName || '—'}</td>
                            <td className="px-5 py-4 text-sm text-slate-500 whitespace-nowrap">{formatDate(p.updatedAt)}</td>
                            <td className="px-5 py-4 text-sm text-slate-400 max-w-xs truncate">Initial Budget Proposal</td>
                            <td className="px-5 py-4 text-right whitespace-nowrap">
                              <ActionMenu align="right">
                                <ActionMenuItem icon="eye" label="View Proposal" onClick={() => navigate(`/budget-planning/wizard/${p.id}/step1?readOnly=true&fromApprovals=true&source=approvals`)} />
                                <ActionMenuItem icon="checkCircle" label="Approve Proposal" variant="success" onClick={() => openProposalModal(p, 'approve')} />
                                <ActionMenuItem icon="xCircle" label="Reject Proposal" variant="danger" onClick={() => openProposalModal(p, 'reject')} />
                              </ActionMenu>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            )
        )}

        {/* ════════════════════════════════════════
            TAB: Top Up Approvals
        ════════════════════════════════════════ */}
        {!loading && activeTab === 'topups' && (
          topupGroups.length === 0
            ? <EmptyState icon="check-circle" title="No Top-Up Requests Pending" sub="All top-up requests have been reviewed." />
            : (
              <div className="space-y-4">
                {topupGroups.map(group => (
                  <TopupGroupCard key={group.taskId} group={group} onAction={openBulkModal} />
                ))}
              </div>
            )
        )}

      </div>

      {/* ════════════════════════════════════════
          Proposal Modal
      ════════════════════════════════════════ */}
      <Modal
        open={!!selectedProposal && !!proposalAction}
        onClose={closeProposalModal}
        title={proposalAction === 'approve' ? 'Approve Budget Proposal' : 'Reject Budget Proposal'}
        footer={
          <div className="flex flex-col-reverse sm:flex-row items-stretch sm:items-center sm:justify-end gap-2 w-full">
            <button onClick={closeProposalModal} disabled={submitting}
              className="w-full sm:w-auto px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-lg transition disabled:opacity-50 text-center">
              Cancel
            </button>
            <button onClick={handleProposalConfirm} disabled={submitting}
              className={`w-full sm:w-auto px-5 py-2 text-sm font-semibold text-white rounded-lg shadow-sm transition disabled:opacity-50 text-center ${proposalAction === 'approve' ? 'bg-accent-600 hover:bg-accent-700' : 'bg-brand-600 hover:bg-brand-700'
                }`}>
              {submitting ? 'Processing…' : proposalAction === 'approve' ? 'Confirm Approve' : 'Confirm Reject'}
            </button>
          </div>
        }
      >
        <div className="py-2 space-y-4">
          {selectedProposal && (
            <div className="bg-slate-50 border border-slate-200 rounded-xl p-3 sm:p-4 text-xs space-y-2">
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-2">
                <div><span className="font-semibold text-slate-500">FY:</span> <span className="font-bold text-slate-800">{selectedProposal.financialYear || '—'}</span></div>
                <div><span className="font-semibold text-slate-500">Total Budget:</span> <span className="font-bold text-brand-700">{formatCurrency(selectedProposal.totalAnnualBudget)}</span></div>
                <div><span className="font-semibold text-slate-500">Requested by:</span> <span className="text-slate-800 font-medium">{selectedProposal.createdByName || '—'}</span></div>
              </div>
            </div>
          )}
          <div className="space-y-1">
            <label className="font-semibold text-slate-700 block text-sm">
              Remarks {proposalAction === 'reject' && <span className="text-brand-600">*</span>}
            </label>
            <textarea
              className={`w-full p-3 border rounded-xl text-sm resize-none focus:outline-none focus:ring-2 transition ${proposalCommentsError ? 'border-brand-400 ring-brand-200' : 'border-slate-300 focus:border-brand-400 focus:ring-brand-100'
                }`}
              rows="3"
              placeholder={proposalAction === 'reject' ? 'Please provide a reason for rejection…' : 'Optional remarks…'}
              value={proposalComments}
              onChange={e => { setProposalComments(e.target.value); if (e.target.value.trim()) setProposalCommentsError(false) }}
            />
            {proposalCommentsError && <p className="text-xs text-brand-600">Reason is required for rejection.</p>}
          </div>
        </div>
      </Modal>

      {/* ════════════════════════════════════════
          Bulk Top-Up Modal
      ════════════════════════════════════════ */}
      <Modal
        open={!!bulkModal}
        onClose={closeBulkModal}
        title={bulkModal?.action === 'approve' ? 'Approve Top-Up Requests' : 'Reject Top-Up Requests'}
        footer={
          <div className="flex flex-col-reverse sm:flex-row items-stretch sm:items-center sm:justify-end gap-2 w-full">
            <button onClick={closeBulkModal} disabled={bulkSubmitting}
              className="w-full sm:w-auto px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-lg transition disabled:opacity-50 text-center">
              Cancel
            </button>
            <button onClick={handleBulkConfirm} disabled={bulkSubmitting || selectedIds.size === 0}
              className={`w-full sm:w-auto px-5 py-2 text-sm font-semibold text-white rounded-lg shadow-sm transition disabled:opacity-50 text-center ${bulkModal?.action === 'approve' ? 'bg-accent-600 hover:bg-accent-700' : 'bg-brand-600 hover:bg-brand-700'
                }`}>
              {bulkSubmitting ? 'Processing…' :
                bulkModal?.action === 'approve'
                  ? `Approve ${selectedIds.size} Request${selectedIds.size !== 1 ? 's' : ''}`
                  : `Reject ${selectedIds.size} Request${selectedIds.size !== 1 ? 's' : ''}`}
            </button>
          </div>
        }
      >
        <div className="py-2 space-y-4">
          {/* Task summary */}
          {bulkModal?.group && (
            <div className="bg-brand-50 border border-brand-100 rounded-xl px-4 py-3 text-xs space-y-1.5">
              <div className="flex flex-wrap gap-x-6 gap-y-1">
                <span><span className="font-semibold text-slate-500">Task:</span> <span className="font-mono font-bold text-slate-800">{formatTaskId(bulkModal.group.taskId)}</span></span>
                <span><span className="font-semibold text-slate-500">Total:</span> <span className="font-bold text-brand-700">{formatCurrency(bulkModal.group.totalTopupAmount)}</span></span>
              </div>
              <div className="flex flex-wrap gap-x-6 gap-y-1">
                <span><span className="font-semibold text-slate-500">Requestor:</span> {bulkModal.group.requestorName || '—'}</span>
                <span><span className="font-semibold text-slate-500">Assignee:</span> {bulkModal.group.assigneeName || '—'}</span>
              </div>
            </div>
          )}

          {/* Select all / clear */}
          <div className="flex items-center justify-between">
            <span className="text-sm font-semibold text-slate-700">
              Select requests to {bulkModal?.action}:
            </span>
            <div className="flex items-center gap-1">
              <button onClick={selectAll} className="text-xs font-semibold text-brand-600 hover:text-brand-800 px-2 py-1 rounded-lg hover:bg-brand-50 transition-colors">Select All</button>
              <span className="text-slate-300 select-none">|</span>
              <button onClick={clearAll} className="text-xs font-semibold text-slate-400 hover:text-slate-600 px-2 py-1 rounded-lg hover:bg-slate-100 transition-colors">Clear</button>
            </div>
          </div>

          {/* Rows table */}
          <div className="rounded-xl border border-slate-200 overflow-hidden">
            <div className="overflow-x-auto" style={{ maxHeight: '260px', overflowY: 'auto' }}>
              <table className="min-w-full text-xs">
                <thead className="bg-slate-50 border-b border-slate-200" style={{ position: 'sticky', top: 0, zIndex: 1 }}>
                  <tr>
                    <th className="px-3 py-2 text-center w-8">
                      <input type="checkbox" className="rounded border-slate-300 text-brand-600 focus:ring-brand-300"
                        checked={selectedIds.size > 0 && selectedIds.size === (bulkModal?.group?.topups?.length || 0)}
                        onChange={e => e.target.checked ? selectAll() : clearAll()} />
                    </th>
                    <th className="px-3 py-2 text-left font-semibold text-slate-500 uppercase tracking-wider">State</th>
                    <th className="px-3 py-2 text-left font-semibold text-slate-500 uppercase tracking-wider">Vertical</th>
                    <th className="px-3 py-2 text-left font-semibold text-slate-500 uppercase tracking-wider hidden sm:table-cell">Period</th>
                    <th className="px-3 py-2 text-right font-semibold text-slate-500 uppercase tracking-wider">Amount</th>
                    <th className="px-3 py-2 text-left font-semibold text-slate-500 uppercase tracking-wider hidden sm:table-cell">Requested By</th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-slate-100">
                  {(bulkModal?.group?.topups || []).map((t, i) => {
                    const checked = selectedIds.has(t.id)
                    return (
                      <tr key={t.id || i} onClick={() => toggleId(t.id)}
                        className={`cursor-pointer transition-colors ${checked ? 'bg-brand-50' : 'hover:bg-slate-50'}`}>
                        <td className="px-3 py-3 text-center" onClick={e => e.stopPropagation()}>
                          <input type="checkbox" className="rounded border-slate-300 text-brand-600 focus:ring-brand-300"
                            checked={checked} onChange={() => toggleId(t.id)} />
                        </td>
                        <td className="px-3 py-3 font-semibold text-slate-800">{t.stateCode || '—'}</td>
                        <td className="px-3 py-3 text-slate-600">{t.verticalName || '—'}</td>
                        <td className="px-3 py-3 text-slate-400 hidden sm:table-cell">{t.periodName || '—'}</td>
                        <td className="px-3 py-3 text-right font-bold text-slate-800">{formatCurrency(t.topupAmount ?? t.amount)}</td>
                        <td className="px-3 py-3 text-slate-400 hidden sm:table-cell">{t.requestedByName || '—'}</td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>
          </div>

          {/* Selection summary */}
          {selectedIds.size > 0 && bulkModal?.group && (
            <div className={`rounded-xl px-4 py-2.5 text-xs font-semibold flex items-center justify-between ${bulkModal.action === 'approve'
              ? 'bg-accent-50 border border-accent-200 text-accent-700'
              : 'bg-brand-50 border border-brand-200 text-brand-700'
              }`}>
              <span>{selectedIds.size} of {bulkModal.group.topups?.length} selected</span>
              <span>Total: {formatCurrency(
                (bulkModal.group.topups || [])
                  .filter(t => selectedIds.has(t.id))
                  .reduce((sum, t) => sum + (Number(t.topupAmount ?? t.amount) || 0), 0)
              )}</span>
            </div>
          )}

          {/* Comments */}
          <div className="space-y-1">
            <label className="font-semibold text-slate-700 block text-sm">
              Remarks {bulkModal?.action === 'reject' && <span className="text-brand-600">*</span>}
            </label>
            <textarea
              className={`w-full p-3 border rounded-xl text-sm resize-none focus:outline-none focus:ring-2 transition ${bulkCommentsError ? 'border-brand-400 ring-brand-200' : 'border-slate-300 focus:border-brand-400 focus:ring-brand-100'
                }`}
              rows="3"
              placeholder={bulkModal?.action === 'reject' ? 'Please provide a reason for rejection…' : 'Optional approval remarks…'}
              value={bulkComments}
              onChange={e => { setBulkComments(e.target.value); if (e.target.value.trim()) setBulkCommentsError(false) }}
            />
            {bulkCommentsError && <p className="text-xs text-brand-600">Remarks are required for rejection.</p>}
          </div>
        </div>
      </Modal>
    </div>
  )
}
